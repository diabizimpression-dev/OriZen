# OriZen — Variables d'environnement
# Copiez ce fichier en .env.local et remplissez les valeurs

# REQUIS — Groq API (gratuit sur console.groq.com)
GROQ_API_KEY=

# Optionnel — URL de production
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optionnel — Navitia transport en commun (navitia.io, gratuit)
NAVITIA_API_KEY=

# Optionnel — Météo-France vigilances officielles
METEOFRANCE_API_KEY=

# Optionnel — Légifrance / Judilibre (piste.gouv.fr, gratuit)
PISTE_CLIENT_ID=
PISTE_CLIENT_SECRET=

# Optionnel — France Travail offres d'emploi (francetravail.io, gratuit)
FRANCE_TRAVAIL_CLIENT_ID=
FRANCE_TRAVAIL_CLIENT_SECRET=

# Optionnel — GenIA-L (payant, lefebvre-dalloz.fr)
GENIAL_API_URL=
GENIAL_API_KEY=

# Optionnel — Dashboard analytics (laisser vide = accès public)
ANALYTICS_SECRET=
